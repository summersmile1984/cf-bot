{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mastra-l1",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mastra-l1",
      "database_id": ""
    }
  ],
  "main": "./.mastra/output/index.mjs",
  "vars": {
    "NODE_ENV": "production",
    "L1_PUBLIC_URL": ""
  },
  "alias": {
    "typescript": "./.mastra/output/typescript-stub.mjs",
    "execa": "./execa-stub.mjs",
    "readable-stream": "./readable-stream-stub.mjs",
    "module": "./.mastra/output/module-stub.mjs",
    "node:module": "./.mastra/output/module-stub.mjs",
    "@opentelemetry/api": "./.mastra/output/opentelemetry-api-stub.mjs"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "om-memory"
    },
    {
      "binding": "VECTORIZE_OBS",
      "index_name": "om-memory-obs"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "OM_QUEUE",
        "queue": "om-cycles"
      }
    ],
    "consumers": [
      {
        "queue": "om-cycles",
        "max_retries": 10,
        "retry_delay": 30
      }
    ]
  }
}