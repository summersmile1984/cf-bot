    {
      "id": "github",
      "name": "GitHub",
      "vendor": "GitHub",
      "category": "研发",
      "description": "仓库/Issue/PR 操作（官方 github-mcp-server，stdio）",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-github"
        ]
      },
      "auth": {
        "type": "api_key",
        "apiKeyName": "GITHUB_PERSONAL_ACCESS_TOKEN",
        "apiKeyHint": "GitHub Personal Access Token（Settings → Developer settings → Tokens）"
      }
    },
    {
      "id": "filesystem",
      "name": "本地文件",
      "vendor": "Model Context Protocol",
      "category": "工具",
      "description": "读写本地文件/目录（官方 filesystem，stdio）",
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "~/"
        ]
      },
      "auth": {
        "type": "none"
      }
    },
