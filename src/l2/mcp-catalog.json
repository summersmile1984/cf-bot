{
  "entries": [
    {
      "id": "google-gmail",
      "name": "Gmail",
      "vendor": "Google",
      "category": "邮箱",
      "description": "搜索/读取邮件线程、写草稿、打标签（Google Workspace 官方远端 MCP）",
      "transport": {
        "type": "remote",
        "url": "https://gmailmcp.googleapis.com/mcp/v1"
      },
      "auth": {
        "type": "oauth2",
        "provider": "google",
        "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
        "tokenUrl": "https://oauth2.googleapis.com/token",
        "scopes": [
          "https://www.googleapis.com/auth/gmail.readonly",
          "https://www.googleapis.com/auth/gmail.compose"
        ],
        "extraAuthParams": {
          "access_type": "offline",
          "prompt": "consent"
        }
      },
      "note": "Developer Preview：需在 Google Cloud 开启 Gmail MCP API；client_id 用户自带"
    },
    {
      "id": "google-calendar",
      "name": "Google 日历",
      "vendor": "Google",
      "category": "日程",
