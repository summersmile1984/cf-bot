{
  "harnesses": [
    {
      "id": "dsh",
      "name": "DeepSeek Harness",
      "vendor": "DeepSeek",
      "acp": "native",
      "command": "dsh",
      "args": [
        "--profile",
        "acp"
      ],
      "versionArgs": [
        "--version"
      ],
      "homepage": "https://deepseek.com",
      "note": "现状默认执行 harness"
    },
    {
      "id": "codebuddy",
      "name": "WorkBuddy / CodeBuddy Code",
      "vendor": "Tencent",
      "acp": "native",
      "command": "npx",
      "args": [
        "-y",
        "@tencent-ai/codebuddy-code@latest",
        "--acp"
      ],
      "versionArgs": [
        "--version"
      ],
      "zeroInstall": true,
      "install": {
        "type": "npx",
        "cmd": "npx -y @tencent-ai/codebuddy-code@latest --version",
        "note": "npx 零安装；首次需在 REPL 里 /login（App 登录不通用）"
      },
      "homepage": "https://www.workbuddy.ai",
      "note": "官方 npx 包（Zed registry 同款）；App 捆绑 shim 缺 dist 不可用、lite-wb 变体 ACP 不回话",
      "detectBins": [
        "codebuddy"
      ]
    },
    {
      "id": "mimo",
      "name": "Xiaomi MiMo Code",
